# --- データベース ---
# 本番(Supabase等)の接続文字列。未設定ならローカルの組込みDB(PGlite, ./.data)を使用
DATABASE_URL=

# --- AI要約 (Claude API) ---
ANTHROPIC_API_KEY=
# 要約用モデル（安価・高速）
AI_SUMMARY_MODEL=claude-haiku-5-5
# 1回の実行で要約する最大件数（費用上限）
AI_MAX_SUMMARIES_PER_RUN=20

# --- 定期実行 ---
# Vercel Cron から /api/cron/ingest を呼ぶ時の認証トークン
CRON_SECRET=

# --- 管理画面 (Basic認証) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- 毎日の重要ニュースBEST5 ---
# 採点・深掘り分析に使うモデル
AI_ANALYSIS_MODEL=claude-sonnet-5-5
# この点数（100点満点）未満のニュースは掲載しない
BRIEF_MIN_SCORE=60
# 単価の上書き（USD/100万トークン）。例: {"claude-sonnet-5-5":{"in":2,"out":10}}
AI_PRICE_OVERRIDES=
